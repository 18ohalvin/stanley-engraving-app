# ==============================================================================
# STANLEY ENGRAVING APP - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Master Developer PIN (Required for initial super admin seeding)
DEVELOPER_MASTER_PIN=dev-secret-pin-1234

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# Supported engines: PostgreSQL, MySQL, SQLite (default fallback)
# ------------------------------------------------------------------------------

# Option 1: Standard Connection URL (Recommended for cloud databases like Neon, Supabase, Railway, Render, RDS)
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/stanley_db?sslmode=disable
# MySQL:
# DATABASE_URL=mysql://root:password@localhost:3306/stanley_db

# Option 2: Individual Connection Parameters
# DB_TYPE=postgres            # postgres | mysql | sqlite
# DB_HOST=localhost
# DB_PORT=5432                # 5432 for Postgres, 3306 for MySQL
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=stanley_db
# DB_SSL=false                # Set to true for cloud SSL connections (AWS RDS, Supabase, etc.)

# If DATABASE_URL and DB_TYPE are left empty, the server automatically uses local SQLite (data/stanley.db).
